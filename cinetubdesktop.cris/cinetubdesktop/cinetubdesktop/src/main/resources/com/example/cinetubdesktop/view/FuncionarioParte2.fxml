<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cinetubdesktop.controller.ControllerFuncionario">
   <children>
      <Label alignment="CENTER" layoutX="150.0" layoutY="20.0" prefHeight="30.0" prefWidth="300.0" text="Funcionários Cadastrados">
         <font>
            <Font name="System Bold Italic" size="20.0" />
         </font>
      </Label>

      <TableView fx:id="tabelaFuncionarios" layoutX="35.0" layoutY="70.0" prefHeight="250.0" prefWidth="530.0">
         <columns>
            <TableColumn fx:id="colNome" prefWidth="220.0" text="Nome" />
            <TableColumn fx:id="colCpf" prefWidth="150.0" text="CPF" />
            <TableColumn fx:id="colCargo" prefWidth="158.0" text="Cargo" />
         </columns>
      </TableView>

      <Button layoutX="35.0" layoutY="335.0" mnemonicParsing="false" onAction="#voltarCadastro" prefHeight="35.0" prefWidth="150.0" text="Voltar para Cadastro" />
   </children>
</AnchorPane>