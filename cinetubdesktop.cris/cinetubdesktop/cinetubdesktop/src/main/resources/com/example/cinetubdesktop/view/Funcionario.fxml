<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="586.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cinetubdesktop.controller.ControllerCadastroFuncionario">
   <children>
      <fx:include source="Navbar.fxml" />

      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="165.0" layoutY="122.0" prefHeight="35.0" prefWidth="300.0" text="Cadastro de Funcionário">
         <font>
            <Font name="System Bold Italic" size="20.0" />
         </font>
      </Label>

      <Label layoutX="53.0" layoutY="196.0" text="Nome completo:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txNome" layoutX="184.0" layoutY="191.0" prefHeight="30.0" prefWidth="350.0" promptText="Digite o nome completo" />

      <Label layoutX="135.0" layoutY="240.0" text="CPF:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txCpf" layoutX="184.0" layoutY="235.0" prefHeight="30.0" prefWidth="350.0" promptText="000.000.000-00" />

      <Label layoutX="128.0" layoutY="283.0" text="Cargo:">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TextField fx:id="txCargo" layoutX="184.0" layoutY="278.0" prefHeight="30.0" prefWidth="350.0" promptText="Digite o cargo" />

      <Button fx:id="btnCadastrar" layoutX="190.0" layoutY="339.0" mnemonicParsing="false" onAction="#CadastrarFuncionario" prefHeight="35.0" prefWidth="100.0" text="Cadastrar" />

      <Button fx:id="btnLimpar" layoutX="315.0" layoutY="339.0" mnemonicParsing="false" onAction="#limpar" prefHeight="35.0" prefWidth="100.0" text="Limpar" />

      <Button layoutX="190.0" layoutY="393.0" mnemonicParsing="false" onAction="#ListarFuncionarios" prefHeight="35.0" prefWidth="225.0" text="Listar Funcionários" />
   </children>
</AnchorPane>
